# Copy this file to .env and fill in your values.

# PostgreSQL connection (create database "taskflow" in pgAdmin first)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/taskflow

# SSL: omit for localhost. Remote DBs enable TLS automatically unless PG_SSL=0.
# PG_SSL=1
# PG_SSL_REJECT_UNAUTHORIZED=1

# Session secret — REQUIRED when NODE_ENV=production (Railway/hosting).
SESSION_SECRET=change-me-long-random-string-in-production

# Optional HTTP port (default 3000)
# PORT=3000

# Comma-separated extra CORS origins (split frontend + API deployments)
# CORS_ORIGINS=https://your-frontend.pages.dev

# Behind Railway/nginx with HTTPS: NODE_ENV=production already enables trust proxy; set TRUST_PROXY=1 to force in dev tunnels.
# TRUST_PROXY=1

# Slow down brute-force (optional tweak)
# AUTH_RATELIMIT_MAX=40
# AUTH_RATELIMIT_WINDOW_MS=900000
